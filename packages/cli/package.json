{
  "name": "pandapaylens",
  "version": "0.13.0",
  "description": "Offline payment error decoder and transaction timeline for Stripe, Adyen, PayPal, Worldpay, Checkout.com and other payment providers. CLI and library.",
  "keywords": [
    "payments",
    "payment-errors",
    "decline-codes",
    "webhooks",
    "stripe",
    "adyen",
    "paypal",
    "worldpay",
    "debugging",
    "cli",
    "offline"
  ],
  "license": "Apache-2.0",
  "author": "Ratomir Jovanovic (https://github.com/ratomirjovanovic)",
  "homepage": "https://github.com/ratomirjovanovic/PandaPayLens#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ratomirjovanovic/PandaPayLens.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/ratomirjovanovic/PandaPayLens/issues",
  "type": "module",
  "bin": {
    "pandapaylens": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs && node scripts/copy-samples.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@pandapaylens/core": "workspace:*",
    "@pandapaylens/providers": "workspace:*",
    "@pandapaylens/rules": "workspace:*",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2"
  }
}
