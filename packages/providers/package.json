{
  "name": "@pandapaylens/providers",
  "version": "0.1.0",
  "description": "Registry of PandaPayLens provider adapters and their capability manifests.",
  "license": "Apache-2.0",
  "author": "Ratomir Jovanovic (https://github.com/ratomirjovanovic)",
  "repository": {
    "type": "git",
    "url": "https://github.com/ratomirjovanovic/PandaPayLens.git",
    "directory": "packages/providers"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifests": {
      "types": "./dist/manifests.d.ts",
      "default": "./dist/manifests.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pandapaylens/adyen": "workspace:*",
    "@pandapaylens/airwallex": "workspace:*",
    "@pandapaylens/astropay": "workspace:*",
    "@pandapaylens/authorize-net": "workspace:*",
    "@pandapaylens/bluesnap": "workspace:*",
    "@pandapaylens/braintree": "workspace:*",
    "@pandapaylens/ccbill": "workspace:*",
    "@pandapaylens/checkout": "workspace:*",
    "@pandapaylens/core": "workspace:*",
    "@pandapaylens/cybersource": "workspace:*",
    "@pandapaylens/decta": "workspace:*",
    "@pandapaylens/dlocal": "workspace:*",
    "@pandapaylens/ebanx": "workspace:*",
    "@pandapaylens/ecommpay": "workspace:*",
    "@pandapaylens/emerchantpay": "workspace:*",
    "@pandapaylens/ezeewallet": "workspace:*",
    "@pandapaylens/finrax": "workspace:*",
    "@pandapaylens/flutterwave": "workspace:*",
    "@pandapaylens/inpay": "workspace:*",
    "@pandapaylens/mifinity": "workspace:*",
    "@pandapaylens/mollie": "workspace:*",
    "@pandapaylens/netbilling": "workspace:*",
    "@pandapaylens/nmi": "workspace:*",
    "@pandapaylens/nuvei": "workspace:*",
    "@pandapaylens/payabl": "workspace:*",
    "@pandapaylens/paymentwall": "workspace:*",
    "@pandapaylens/paypal": "workspace:*",
    "@pandapaylens/paysafe": "workspace:*",
    "@pandapaylens/paystack": "workspace:*",
    "@pandapaylens/payu-india": "workspace:*",
    "@pandapaylens/pxp": "workspace:*",
    "@pandapaylens/rapyd": "workspace:*",
    "@pandapaylens/razorpay": "workspace:*",
    "@pandapaylens/segpay": "workspace:*",
    "@pandapaylens/skrill": "workspace:*",
    "@pandapaylens/square": "workspace:*",
    "@pandapaylens/stripe": "workspace:*",
    "@pandapaylens/trust-payments": "workspace:*",
    "@pandapaylens/trustly": "workspace:*",
    "@pandapaylens/verotel": "workspace:*",
    "@pandapaylens/worldpay": "workspace:*"
  }
}
